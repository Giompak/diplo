<?xml version="1.0" encoding="UTF-8"?>
<statechart:Model xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:statechart="http://statechart/1.0" name="Distributor">
  <nodes name="Distributor" label="0" type="OR">
    <Children name="0.1" label="0.1" type="START"/>
    <Children name="sendSupply_Distributor" label="0.2" type="OR">
      <Children name="0.2.1" label="0.2.1" type="START"/>
      <Children name="registerItems" label="0.2.2" type="BASIC"/>
      <Children name="sendReceipt" label="0.2.3" type="BASIC"/>
      <Children name="0.2.4" label="0.2.4" type="END"/>
    </Children>
    <Children name="checkSupply_Distributor" label="0.3" type="OR">
      <Children name="0.3.1" label="0.3.1" type="START"/>
      <Children name="supplySent" label="0.3.2" type="BASIC"/>
      <Children name="receiveProof" label="0.3.3" type="BASIC"/>
      <Children name="0.3.4" label="0.3.4" type="END"/>
    </Children>
    <Children name="approveSupply_Distributor" label="0.4" type="OR">
      <Children name="0.4.1" label="0.4.1" type="START"/>
      <Children name="receiveFeedback" label="0.4.2" type="BASIC"/>
      <Children name="0.4.3" label="0.4.3" type="END"/>
    </Children>
    <Children name="sendStock_Distributor" label="0.5" type="OR">
      <Children name="0.5.1" label="0.5.1" type="START"/>
      <Children name="receiveReceipt" label="0.5.2" type="BASIC"/>
      <Children name="0.5.4" label="0.5.4" type="END"/>
      <Children name="emailConfirmation" type="BASIC"/>
    </Children>
    <Children name="0.6" label="0.6" type="END"/>
    <Children name="distributorInitialization" type="BASIC"/>
  </nodes>
  <transitions TE="func_receiveProductFromProcessor(product)/processedCropReceived=false" name="0.1TOsendSupply_Distributor" source="//@nodes.0/@Children.6" target="//@nodes.0/@Children.1"/>
  <transitions TE="/supplyReady=true" name="sendSupply_DistributorTOcheckSupply_Distributor" source="//@nodes.0/@Children.1" target="//@nodes.0/@Children.2"/>
  <transitions TE="/func_sendProductToRegulator(product)" name="checkSupply_DistributorTOapproveSupply_Distributor" source="//@nodes.0/@Children.2" target="//@nodes.0/@Children.3"/>
  <transitions TE="func_receiveProductFromRegulator(product)/evaluateSupply=true" name="approveSupply_DistributorTOsendStock_Distributor" source="//@nodes.0/@Children.3" target="//@nodes.0/@Children.4"/>
  <transitions name="sendStock_DistributorTO0.6" source="//@nodes.0/@Children.4" target="//@nodes.0/@Children.5"/>
  <transitions name="0.2.1TOregisterItems" source="//@nodes.0/@Children.1/@Children.0" target="//@nodes.0/@Children.1/@Children.1"/>
  <transitions TE="[func_addStock(product)]/processedCropReceived=true" name="registerItemsTOsendReceipt" source="//@nodes.0/@Children.1/@Children.1" target="//@nodes.0/@Children.1/@Children.2"/>
  <transitions TE="/supplyReady=false" name="sendReceiptTO0.2.4" source="//@nodes.0/@Children.1/@Children.2" target="//@nodes.0/@Children.1/@Children.3"/>
  <transitions TE="/supplySent=false" name="0.3.1TOsupplySent" source="//@nodes.0/@Children.2/@Children.0" target="//@nodes.0/@Children.2/@Children.1"/>
  <transitions TE="[func_removeStock(product)]/supplySent=true" name="supplySentTOreceiveProof" source="//@nodes.0/@Children.2/@Children.1" target="//@nodes.0/@Children.2/@Children.2"/>
  <transitions name="receiveProofTO0.3.4" source="//@nodes.0/@Children.2/@Children.2" target="//@nodes.0/@Children.2/@Children.3"/>
  <transitions name="0.4.1TOreceiveFeedback" source="//@nodes.0/@Children.3/@Children.0" target="//@nodes.0/@Children.3/@Children.1"/>
  <transitions TE="[evaluateSupply]" name="receiveFeedbackTOreceiveFeedback" source="//@nodes.0/@Children.3/@Children.1" target="//@nodes.0/@Children.3/@Children.1"/>
  <transitions name="receiveFeedbackTO0.4.3" source="//@nodes.0/@Children.3/@Children.1" target="//@nodes.0/@Children.3/@Children.2"/>
  <transitions name="0.5.1TOreceiveReceipt" source="//@nodes.0/@Children.4/@Children.0" target="//@nodes.0/@Children.4/@Children.1"/>
  <transitions TE="/func_sendProductToRetailer(product)" name="_open_option_emailConfirmation_close_option_TO0.5.4" source="//@nodes.0/@Children.4/@Children.3" target="//@nodes.0/@Children.4/@Children.2"/>
  <transitions TE="/feedbackReceived=true" source="//@nodes.0/@Children.4/@Children.1" target="//@nodes.0/@Children.4/@Children.3"/>
  <transitions source="//@nodes.0/@Children.0" target="//@nodes.0/@Children.6"/>
</statechart:Model>
